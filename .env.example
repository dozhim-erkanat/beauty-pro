# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Название сайта в шапке и заголовках
NEXT_PUBLIC_SITE_NAME=Beauty Pro

# Green API — уведомления о заявках и заказах в группу WhatsApp.
# Без этих переменных сайт работает как обычно, просто не шлёт уведомления.
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN=
GREEN_API_CHAT_ID=120363000000000000@g.us

# Адрес сайта — подставляется в ссылку внутри сообщения WhatsApp
NEXT_PUBLIC_SITE_URL=https://beautypro.com.kz
